# ---------------------------------------------------------------------------
# QUBeditotron3000 — root .gitignore
# Polyglot microservices: Python, Node.js, PHP, Docker
# ---------------------------------------------------------------------------

# ── Secrets / environment ──────────────────────────────────────────────────
.env
.env.*
!.env.example
*.local
# Firebase / Google Cloud service-account credentials
*serviceAccount*.json
*service-account*.json
*-credentials.json
google-credentials.json
firebase-adminsdk*.json
# Frontend Firebase web config (real values live here; commit the .example only)
editor-frontend/src/firebase-config.js

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg
*.egg
# Virtual environments
.venv/
venv/
env/
ENV/
# Test / coverage / tooling caches
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/

# ── Node.js (charcount) ──────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.eslintcache
coverage/

# Note: package-lock.json is intentionally NOT ignored — lockfiles should be
# committed for reproducible builds. (The old per-service .gitignore ignored
# it; prefer committing it.)

# ── PHP (wordcount) ──────────────────────────────────────────────────────
vendor/
composer.phar
.phpunit.result.cache

# ── Docker ───────────────────────────────────────────────────────────────
# Compose override files are usually local-only
docker-compose.override.yml
docker-compose.*.local.yml

# ── Logs ───────────────────────────────────────────────────────────────────
*.log
logs/

# ── IDE / editors ──────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.code-workspace

# ── OS cruft ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
