# Copy this file to .env and fill in real values. .env is git-ignored.
# Used by docker-compose to inject email-alert settings into the monitor service.

# SMTP server for outgoing alert emails (Gmail shown as an example)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Account that sends alerts. For Gmail use an App Password, NOT your login
# password: https://myaccount.google.com/apppasswords
SENDER_EMAIL=you@example.com
SENDER_PASSWORD=your_app_password_here

# Where alerts are delivered (defaults to SENDER_EMAIL if omitted)
RECIPIENT_EMAIL=you@example.com
